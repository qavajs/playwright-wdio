{
  "name": "@qavajs/playwright-wdio",
  "version": "2.0.0",
  "description": "steps to interact with playwright wdio adapter",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./steps": "./steps.js",
    "./steps.js": "./steps.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "steps.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "tsx --test 'test/**/*.test.ts'",
    "start:server": "tsx test-e2e/support/server.ts",
    "debug:e2e": "playwright test --config test-e2e/playwright.config.ts --ui",
    "test:e2e": "playwright test --config test-e2e/playwright.e2e.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/playwright-wdio.git"
  },
  "authors": [
    "Alexandr Galichenko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qavajs/playwright-wdio/issues"
  },
  "homepage": "https://github.com/qavajs/playwright-wdio#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@playwright/test": "^1.65.0",
    "@qavajs/memory": "^1.11.0",
    "@qavajs/playwright-runner-adapter": "^2.7.0",
    "@qavajs/playwright-wdio-fixtures": "^2.1.0",
    "webdriverio": "^10.2.0"
  }
}
